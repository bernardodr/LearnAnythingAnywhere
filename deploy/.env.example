# The production settings: copy to /opt/laa/.env on the server, fill in, then `chmod 600 .env` (root only).
# Type the secrets on the server itself. They never go in the repository, an issue or a chat.
# Docker Compose reads this file, and the server gets all of it as its environment (deploy/compose.yml).
# Values with spaces or < > go in double quotes.

# ---- Set by deploy.sh: the live version and the one before it. Leave them alone.
LAA_TAG=
LAA_PREVIOUS_TAG=
# Where `./deploy.sh <tag>` pulls images from (the deploy workflow pushes them there)
LAA_IMAGES=ghcr.io/bernardodr

# ---- The two addresses. Caddy gets HTTPS certificates for both, so their DNS records must point at this server.
LAA_WEB_URL=https://learnanythinganywhere.app
LAA_API_URL=https://api.learnanythinganywhere.app

# ---- Secrets. Generate each one on the server.
# The database password: openssl rand -hex 24 (set once; changing it later needs the database changed too)
POSTGRES_PASSWORD=
# Signs every sign-in: openssl rand -hex 32. Changing it signs everyone out.
JWT_SECRET=

# ---- The owner (you): the email that may open the owner console, and the code that lets it sign up.
LAA_OWNER_EMAILS=
# openssl rand -hex 16. Needed once, to create your owner account; you can clear it afterwards.
LAA_OWNER_SETUP_CODE=

# ---- AI. The default service for the new database (ANTHROPIC, OPENAI or GOOGLE); after that the owner console decides.
LAA_DEFAULT_PROVIDER=OPENAI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Daily caps on estimated AI spend, in US dollars (reset at midnight UTC). Kept low for the beta.
LAA_LEARNER_DAILY_USD=1.00
LAA_TOTAL_DAILY_USD=5.00

# ---- Email (docs/EMAIL.md): Cloudflare Email Sending over port 465.
SPRING_MAIL_HOST=smtp.mx.cloudflare.net
SPRING_MAIL_PORT=465
SPRING_MAIL_SSL_ENABLED=true
SPRING_MAIL_USERNAME=api_token
SPRING_MAIL_PASSWORD=
LAA_MAIL_FROM="Learn Anything Anywhere <support@learnanythinganywhere.app>"

# ---- Never set these here: dev sign-in, /dev tools and practice mode are for laptops only, and the server's own
# defaults keep them off. (LAA_DEV_LOGIN, LAA_DEV_ENDPOINTS, LAA_PRACTICE_PROVIDERS, LAA_MAIL_OUTBOX)
