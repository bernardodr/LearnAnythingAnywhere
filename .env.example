# Host port for the Docker Postgres; change both lines if 5432 is taken locally
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/laa
DATABASE_USER=laa
DATABASE_PASSWORD=laa
# Required. At least 32 bytes; the server refuses to start with "change-me". Generate: openssl rand -hex 32
JWT_SECRET=change-me
# Optional: comma-separated emails that may be OWNER (default owner@laa.dev)
# LAA_OWNER_EMAILS=owner@laa.dev
# Optional: making an account with an owner email needs this code. Unset = owner emails can't sign up
# (dev sign-in still works). Generate: openssl rand -hex 16
LAA_OWNER_SETUP_CODE=
# Email-only sign-in for local development. Off unless true; ./dev.sh turns it on. Never on a shared server.
# LAA_DEV_LOGIN=true
# Optional: default LLM provider for a fresh database (default FAKE); after that the owner console decides
# LAA_DEFAULT_PROVIDER=FAKE
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
SEARCH_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:8080
