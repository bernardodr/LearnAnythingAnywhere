# Host port for the Docker Postgres; change both lines if 5432 is taken locally
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/laa
DATABASE_USER=laa
DATABASE_PASSWORD=laa
# Required. At least 32 bytes; the server refuses to start with "change-me". Generate: openssl rand -hex 32
JWT_SECRET=change-me
# Optional: comma-separated emails that may be OWNER (default owner@laa.dev)
# LAA_OWNER_EMAILS=owner@laa.dev
# Optional: making an account with an owner email needs this code. Unset = owner emails can't sign up
# (dev sign-in still works). Generate: openssl rand -hex 16
LAA_OWNER_SETUP_CODE=
# Local-development switches. All off unless true; ./dev.sh turns them on. Never on a shared server.
# LAA_DEV_LOGIN=true            # email-only sign-in
# LAA_DEV_ENDPOINTS=true        # /dev tools
# LAA_PRACTICE_PROVIDERS=true   # practice mode (FAKE, FAKE_B)
# Daily caps on estimated AI spend, in US dollars (reset at midnight UTC)
# LAA_LEARNER_DAILY_USD=1.00
# LAA_TOTAL_DAILY_USD=25.00
# Email (verification and password reset). ./dev.sh uses Mailpit (localhost:1025, read at http://localhost:8025).
# For real email, your provider's SMTP settings:
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SMTP_STARTTLS_REQUIRED=true
# LAA_MAIL_FROM=Learn Anything Anywhere <no-reply@your-domain>
# Where links in emails point: the web app's address
# LAA_APP_URL=http://localhost:8081
# Default AI service for a new database (required then: ANTHROPIC, OPENAI, GOOGLE or OLLAMA; ./dev.sh uses FAKE).
# After that the owner console decides.
# LAA_DEFAULT_PROVIDER=ANTHROPIC
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
SEARCH_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:8080
